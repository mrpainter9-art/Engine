{
  "name": "engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A small 2D pixel-art game engine with a Godot-style web editor.",
  "scripts": {
    "dev": "node server/server.mjs --dev --project examples/train-window",
    "build": "vite build",
    "editor": "vite build && node server/server.mjs --project examples/train-window",
    "start": "node server/server.mjs",
    "export:web": "node server/export.mjs",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "codemirror": "6.0.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
